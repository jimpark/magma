# Fails when Magma reaches outside itself, or when the umbrella header is incomplete:
#   - a quoted include with a directory must be a magma/ or basalt/ header;
#   - a public header may not include SDL, which is a private dependency;
#   - magma/magma.h must include every other public header.
# Usage: cmake -DMAGMA_SOURCE_DIR=<repo> -P <this>
cmake_minimum_required(VERSION 3.25)

set(_errors "")
set(_include_regex "^[ \t]*#[ \t]*include[ \t]*\"([^\"]+)\"")
set(_private_regex "^[ \t]*#[ \t]*include[ \t]*<(SDL3/[^>]+)>")

file(GLOB_RECURSE _files "${MAGMA_SOURCE_DIR}/include/*" "${MAGMA_SOURCE_DIR}/src/*")
foreach(_file IN LISTS _files)
  if(NOT _file MATCHES "\\.(h|hpp|cpp|mm)$")
    continue()
  endif()
  file(RELATIVE_PATH _rel "${MAGMA_SOURCE_DIR}" "${_file}")
  file(STRINGS "${_file}" _lines REGEX "${_include_regex}")
  foreach(_line IN LISTS _lines)
    string(REGEX REPLACE "${_include_regex}.*" "\\1" _include "${_line}")
    if(_include MATCHES "/" AND NOT _include MATCHES "^(magma|basalt)/")
      list(APPEND _errors "${_rel}: may not include \"${_include}\"")
    endif()
    if(_include STREQUAL "magma/magma.h")
      list(APPEND _errors "${_rel}: may not include the umbrella header")
    endif()
  endforeach()
  if(_rel MATCHES "^include/")
    file(STRINGS "${_file}" _private_lines REGEX "${_private_regex}")
    foreach(_line IN LISTS _private_lines)
      string(REGEX REPLACE "${_private_regex}.*" "\\1" _include "${_line}")
      list(APPEND _errors "${_rel}: public header may not include <${_include}>")
    endforeach()
  endif()
endforeach()

file(GLOB_RECURSE _public RELATIVE "${MAGMA_SOURCE_DIR}/include" "${MAGMA_SOURCE_DIR}/include/*.h")
file(STRINGS "${MAGMA_SOURCE_DIR}/include/magma/magma.h" _umbrella_lines REGEX "${_include_regex}")
set(_umbrella "")
foreach(_line IN LISTS _umbrella_lines)
  string(REGEX REPLACE "${_include_regex}.*" "\\1" _include "${_line}")
  list(APPEND _umbrella "${_include}")
endforeach()
foreach(_header IN LISTS _public)
  if(NOT _header STREQUAL "magma/magma.h" AND NOT _header IN_LIST _umbrella)
    list(APPEND _errors "include/magma/magma.h: does not include \"${_header}\"")
  endif()
endforeach()

if(_errors)
  list(JOIN _errors "\n  " _message)
  message(FATAL_ERROR "Include boundary violations:\n  ${_message}")
endif()
message(STATUS "Include boundaries OK")
